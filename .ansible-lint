---
exclude_paths:
  # Platform sets are Molecule base configs, not playbooks.
  - molecule/platforms/
  # Role symlinks a local Molecule run needs, pointing at the repository
  # root. They are gitignored, but if one is present ansible-lint follows
  # it into a self-referential tree and takes minutes instead of seconds.
  - molecule/*/roles/

skip_list:
  - '306'  # [306] Shells that use pipes should set the pipefail option
  - 'args' # [args] throws a warning on community.docker.docker_container for a correct attribute (cgroupns_mode)
